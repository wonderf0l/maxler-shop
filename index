<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maxler — официальный магазин спортивного питания</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f9fafc;
            color: #1a1e2b;
            line-height: 1.5;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 25px;
        }

        /* Шапка */
        .header {
            background: white;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            padding: 15px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            font-size: 2.2rem;
            color: #e63946;
            font-weight: 700;
        }

        .logo-text h1 {
            font-size: 1.8rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logo-text p {
            font-size: 0.8rem;
            color: #64748b;
            letter-spacing: 1px;
        }

        .nav-menu {
            display: flex;
            gap: 30px;
        }

        .nav-link {
            text-decoration: none;
            color: #334155;
            font-weight: 500;
            transition: color 0.2s;
        }

        .nav-link:hover {
            color: #e63946;
        }

        /* Корзина в шапке */
        .cart-icon {
            position: relative;
            font-size: 1.5rem;
            color: #1e293b;
            cursor: pointer;
        }

        .cart-count {
            position: absolute;
            top: -10px;
            right: -10px;
            background: #e63946;
            color: white;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 3px 7px;
            border-radius: 50px;
            min-width: 20px;
            text-align: center;
        }

        /* Герой (Hero) секция */
        .hero {
            background: linear-gradient(105deg, #0f172a 0%, #1e293b 100%);
            color: white;
            padding: 70px 0;
            margin-bottom: 50px;
            border-radius: 0 0 40px 40px;
        }

        .hero-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
            flex-wrap: wrap;
        }

        .hero-text h2 {
            font-size: 3rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .hero-text p {
            font-size: 1.2rem;
            opacity: 0.9;
            max-width: 600px;
        }

        .hero-highlight {
            color: #e63946;
            font-weight: 700;
        }

        .hero-badge {
            background: rgba(230, 57, 70, 0.2);
            padding: 15px 30px;
            border-radius: 60px;
            border: 1px solid rgba(230,57,70,0.5);
            font-size: 1.2rem;
            font-weight: 600;
        }

        /* Фильтр / Категории */
        .categories {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 40px;
            justify-content: center;
        }

        .category-btn {
            background: white;
            border: 1px solid #e2e8f0;
            padding: 12px 28px;
            border-radius: 50px;
            font-weight: 600;
            color: #334155;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.95rem;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
        }

        .category-btn:hover, .category-btn.active {
            background: #e63946;
            color: white;
            border-color: #e63946;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(230,57,70,0.2);
        }

        /* Сетка товаров */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
            margin-bottom: 60px;
        }

        .product-card {
            background: white;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 15px 30px rgba(0,0,0,0.03);
            transition: all 0.3s ease;
            border: 1px solid #f1f5f9;
            display: flex;
            flex-direction: column;
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 40px rgba(230,57,70,0.08);
            border-color: #fecdd3;
        }

        .product-img {
            height: 220px;
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px;
            position: relative;
        }

        .product-img img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: transform 0.3s;
        }

        .product-card:hover .product-img img {
            transform: scale(1.05);
        }

        .product-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            background: #e63946;
            color: white;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 50px;
            text-transform: uppercase;
        }

        .product-info {
            padding: 20px 20px 25px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .product-category {
            font-size: 0.8rem;
            color: #e63946;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .product-title {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: #0f172a;
            line-height: 1.4;
        }

        .product-taste {
            color: #64748b;
            font-size: 0.9rem;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .product-taste i {
            color: #e63946;
            font-size: 0.7rem;
        }

        .product-bottom {
            margin-top: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .product-price {
            font-size: 1.6rem;
            font-weight: 800;
            color: #0f172a;
        }

        .product-price small {
            font-size: 0.9rem;
            font-weight: 500;
            color: #94a3b8;
        }

        .add-to-cart {
            background: #0f172a;
            color: white;
            border: none;
            width: 48px;
            height: 48px;
            border-radius: 60px;
            font-size: 1.3rem;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .add-to-cart:hover {
            background: #e63946;
            transform: scale(1.1);
        }

        /* Боковая панель корзины */
        .cart-overlay {
            position: fixed;
            top: 0;
            right: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
            z-index: 2000;
            visibility: hidden;
            opacity: 0;
            transition: 0.3s;
        }

        .cart-overlay.active {
            visibility: visible;
            opacity: 1;
        }

        .cart-sidebar {
            position: fixed;
            top: 0;
            right: -450px;
            width: 100%;
            max-width: 420px;
            height: 100%;
            background: white;
            box-shadow: -10px 0 30px rgba(0,0,0,0.1);
            z-index: 2001;
            transition: right 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .cart-sidebar.active {
            right: 0;
        }

        .cart-header {
            padding: 25px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .cart-header h3 {
            font-size: 1.4rem;
            font-weight: 700;
        }

        .close-cart {
            background: none;
            border: none;
            font-size: 1.8rem;
            cursor: pointer;
            color: #94a3b8;
            transition: color 0.2s;
        }

        .close-cart:hover {
            color: #e63946;
        }

        .cart-items {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }

        .cart-item {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 1px solid #f1f5f9;
        }

        .cart-item-img {
            width: 70px;
            height: 70px;
            background: #f8fafc;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px;
        }

        .cart-item-img img {
            max-width: 100%;
            max-height: 100%;
        }

        .cart-item-info {
            flex: 1;
        }

        .cart-item-title {
            font-weight: 600;
            margin-bottom: 5px;
        }

        .cart-item-taste {
            font-size: 0.8rem;
            color: #64748b;
        }

        .cart-item-price {
            font-weight: 700;
            color: #e63946;
        }

        .cart-item-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 8px;
        }

        .cart-item-actions button {
            background: #f1f5f9;
            border: none;
            width: 28px;
            height: 28px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

        .cart-item-actions button:hover {
            background: #e63946;
            color: white;
        }

        .cart-item-quantity {
            font-weight: 600;
            min-width: 25px;
            text-align: center;
        }

        .remove-item {
            color: #94a3b8;
            background: none;
            border: none;
            font-size: 1.1rem;
            cursor: pointer;
            margin-left: auto;
        }

        .cart-footer {
            padding: 25px;
            border-top: 1px solid #f1f5f9;
            background: #f8fafc;
        }

        .cart-total {
            display: flex;
            justify-content: space-between;
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .checkout-btn {
            width: 100%;
            background: #e63946;
            color: white;
            border: none;
            padding: 16px;
            border-radius: 40px;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: 0.2s;
        }

        .checkout-btn:hover {
            background: #c82333;
            transform: scale(1.02);
        }

        .empty-cart {
            text-align: center;
            color: #94a3b8;
            padding: 40px 20px;
        }

        /* Уведомления */
        .notification {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: #0f172a;
            color: white;
            padding: 15px 25px;
            border-radius: 60px;
            font-weight: 500;
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
            transform: translateY(100px);
            opacity: 0;
            transition: 0.3s;
            z-index: 3000;
        }

        .notification.show {
            transform: translateY(0);
            opacity: 1;
        }

        /* Футер */
        .footer {
            background: #0f172a;
            color: #cbd5e1;
            padding: 50px 0 30px;
            margin-top: 80px;
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 40px;
        }

        .footer-col p {
            margin: 10px 0;
        }

        .footer-col i {
            color: #e63946;
            width: 25px;
        }

        .copyright {
            text-align: center;
            padding-top: 40px;
            margin-top: 40px;
            border-top: 1px solid #1e293b;
        }

        @media (max-width: 768px) {
            .hero-text h2 {
                font-size: 2.2rem;
            }
            .header-content {
                flex-direction: column;
            }
            .nav-menu {
                flex-wrap: wrap;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <!-- Шапка -->
    <header class="header">
        <div class="container header-content">
            <div class="logo">
                <div class="logo-icon">MAX</div>
                <div class="logo-text">
                    <h1>Maxler</h1>
                    <p>SPORT NUTRITION</p>
                </div>
            </div>
            <nav class="nav-menu">
                <a href="#" class="nav-link">Главная</a>
                <a href="#" class="nav-link">Каталог</a>
                <a href="#" class="nav-link">О бренде</a>
                <a href="#" class="nav-link">Доставка</a>
                <a href="#" class="nav-link">Контакты</a>
            </nav>
            <div class="cart-icon" onclick="toggleCart()">
                <i class="fas fa-shopping-bag"></i>
                <span class="cart-count" id="cartCount">0</span>
            </div>
        </div>
    </header>

    <!-- Hero секция -->
    <section class="hero">
        <div class="container hero-content">
            <div class="hero-text">
                <h2>Спорт питание<br><span class="hero-highlight">Maxler</span> — твой результат</h2>
                <p>100% оригинальная продукция. Сертифицированные БАДы, протеины, гейнеры и креатин для твоих целей.</p>
            </div>
            <div class="hero-badge">
                <i class="fas fa-check-circle" style="color: #e63946;"></i> В МЕСЯЦ РАМАДАН СКИДКА 30%
            </div>
        </div>
    </section>

    <div class="container">
        <!-- Категории -->
        <div class="categories">
            <button class="category-btn active" data-category="all">Все товары</button>
            <button class="category-btn" data-category="protein">Протеины</button>
            <button class="category-btn" data-category="creatine">Креатин</button>
            <button class="category-btn" data-category="gainer">Гейнеры</button>
            <button class="category-btn" data-category="bads">БАДы</button>
        </div>

        <!-- Сетка товаров -->
        <div class="products-grid" id="productsGrid"></div>
    </div>

    <!-- Боковая корзина -->
    <div class="cart-overlay" id="cartOverlay" onclick="toggleCart()"></div>
    <div class="cart-sidebar" id="cartSidebar">
        <div class="cart-header">
            <h3>Корзина <span id="cartItemCount">(0)</span></h3>
            <button class="close-cart" onclick="toggleCart()"><i class="fas fa-times"></i></button>
        </div>
        <div class="cart-items" id="cartItems"></div>
        <div class="cart-footer" id="cartFooter">
            <div class="cart-total">
                <span>Итого:</span>
                <span id="cartTotal">0 ₽</span>
            </div>
            <button class="checkout-btn" onclick="openCheckoutForm()">Оформить заказ</button>
        </div>
    </div>

    <!-- Уведомление -->
    <div class="notification" id="notification">Товар добавлен в корзину</div>

    <!-- Футер -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-col">
                    <h4>Maxler Russia</h4>
                    <p>Официальный дистрибьютор</p>
                    <p><i class="fas fa-phone"></i> 8 (800) 555-35-35</p>
                    <p><i class="fas fa-envelope"></i> shop@maxler.ru</p>
                </div>
                <div class="footer-col">
                    <h4>Информация</h4>
                    <p>О компании</p>
                    <p>Доставка и оплата</p>
                    <p>Политика конфиденциальности</p>
                </div>
                <div class="footer-col">
                    <h4>Мы в соцсетях</h4>
                    <p><i class="fab fa-vk"></i> ВКонтакте</p>
                    <p><i class="fab fa-telegram"></i> Telegram</p>
                </div>
            </div>
            <div class="copyright">
                © 2026 Maxler. Все права защищены.
            </div>
        </div>
    </footer>

    <script>
        // Данные товаров (Maxler)
        const products = [
            {
                id: 1,
                name: "100% Whey Gold",
                category: "protein",
                taste: "Шоколад",
                price: 2990,
                oldPrice: 3500,
                img: "https://m.media-amazon.com/images/I/71pXxv6hYlL._AC_SL1500_.jpg",
                badge: "Хит"
            },
            {
                id: 2,
                name: "100% Whey Gold",
                category: "protein",
                taste: "Ваниль",
                price: 2990,
                img: "https://iili.io/qJSLRV4.md.webp"
            },
            {
                id: 3,
                name: "100% Whey Gold",
                category: "protein",
                taste: "Клубника",
                price: 2990,
                img: "https://m.media-amazon.com/images/I/71pXxv6hYlL._AC_SL1500_.jpg"
            },
            {
                id: 4,
                name: "Micellar Casein",
                category: "protein",
                taste: "Шоколад-фундук",
                price: 3250,
                img: "https://m.media-amazon.com/images/I/71QrHj6I8KL._AC_SL1500_.jpg"
            },
            {
                id: 5,
                name: "Creatine Monohydrate",
                category: "creatine",
                taste: "Без вкуса",
                price: 1490,
                img: "https://m.media-amazon.com/images/I/71QrHj6I8KL._AC_SL1500_.jpg"
            },
            {
                id: 6,
                name: "Creapure® Creatine",
                category: "creatine",
                taste: "Капсулы",
                price: 2190,
                img: "https://m.media-amazon.com/images/I/71pXxv6hYlL._AC_SL1500_.jpg"
            },
            {
                id: 7,
                name: "Mass Gainer",
                category: "gainer",
                taste: "Банан",
                price: 2790,
                img: "https://m.media-amazon.com/images/I/71K6pWaD6bL._AC_SL1500_.jpg"
            },
            {
                id: 8,
                name: "Mass Gainer",
                category: "gainer",
                taste: "Шоколад",
                price: 2790,
                img: "https://m.media-amazon.com/images/I/71pXxv6hYlL._AC_SL1500_.jpg"
            },
            {
                id: 9,
                name: "L-Carnitine Liquid",
                category: "bads",
                taste: "Апельсин",
                price: 1890,
                img: "https://m.media-amazon.com/images/I/71QrHj6I8KL._AC_SL1500_.jpg"
            },
            {
                id: 10,
                name: "Omega-3",
                category: "bads",
                taste: "Капсулы",
                price: 1350,
                img: "https://iili.io/qJStJR9.md.jpg"
            },
            {
                id: 11,
                name: "BCAA 4:1:1",
                category: "bads",
                taste: "Лимон",
                price: 2290,
                img: "https://m.media-amazon.com/images/I/71pXxv6hYlL._AC_SL1500_.jpg"
            },
            {
                id: 12,
                name: "ZMA",
                category: "bads",
                taste: "Капсулы",
                price: 1690,
                img: "https://m.media-amazon.com/images/I/71QrHj6I8KL._AC_SL1500_.jpg"
            }
        ];

        // Корзина
        let cart = JSON.parse(localStorage.getItem('maxlerCart')) || [];

        // Элементы DOM
        const productsGrid = document.getElementById('productsGrid');
        const cartCount = document.getElementById('cartCount');
        const cartItems = document.getElementById('cartItems');
        const cartTotal = document.getElementById('cartTotal');
        const cartFooter = document.getElementById('cartFooter');
        const cartItemCount = document.getElementById('cartItemCount');
        const notification = document.getElementById('notification');

        // Рендер товаров
        function renderProducts(category = 'all') {
            productsGrid.innerHTML = '';
            const filtered = category === 'all' ? products : products.filter(p => p.category === category);
            
            filtered.forEach(product => {
                const card = document.createElement('div');
                card.className = 'product-card';
                card.innerHTML = `
                    <div class="product-img">
                        ${product.badge ? '<span class="product-badge">' + product.badge + '</span>' : ''}
                        <img src="${product.img}" alt="${product.name}">
                    </div>
                    <div class="product-info">
                        <div class="product-category">${getCategoryName(product.category)}</div>
                        <div class="product-title">${product.name}</div>
                        <div class="product-taste"><i class="fas fa-flask"></i> ${product.taste}</div>
                        <div class="product-bottom">
                            <div class="product-price">${product.price.toLocaleString()} ₽</div>
                            <button class="add-to-cart" onclick="addToCart(${product.id})"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                `;
                productsGrid.appendChild(card);
            });
        }

        function getCategoryName(cat) {
            const map = {
                protein: 'ПРОТЕИН',
                creatine: 'КРЕАТИН',
                gainer: 'ГЕЙНЕР',
                bads: 'БАД'
            };
            return map[cat] || cat;
        }

        // Добавление в корзину
        window.addToCart = (productId) => {
            const product = products.find(p => p.id === productId);
            const existing = cart.find(item => item.id === productId);
            
            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({ ...product, quantity: 1 });
            }
            
            updateCart();
            showNotification('Товар добавлен в корзину');
        };

        // Обновление корзины
        function updateCart() {
            localStorage.setItem('maxlerCart', JSON.stringify(cart));
            
            // Общее количество
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            cartCount.textContent = totalItems;
            
            // Рендер элементов корзины
            renderCartItems();
            
            // Обновление итога
            const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            cartTotal.textContent = total.toLocaleString() + ' ₽';
            
            if (cartItemCount) {
                cartItemCount.textContent = `(${totalItems})`;
            }
        }

        function renderCartItems() {
            if (!cartItems) return;
            
            if (cart.length === 0) {
                cartItems.innerHTML = '<div class="empty-cart"><i class="fas fa-shopping-bag" style="font-size: 3rem; opacity: 0.3; margin-bottom: 15px;"></i><p>Корзина пуста</p></div>';
                return;
            }
            
            cartItems.innerHTML = cart.map(item => `
                <div class="cart-item">
                    <div class="cart-item-img">
                        <img src="${item.img}" alt="${item.name}">
                    </div>
                    <div class="cart-item-info">
                        <div class="cart-item-title">${item.name}</div>
                        <div class="cart-item-taste">${item.taste}</div>
                        <div class="cart-item-price">${item.price} ₽</div>
                        <div class="cart-item-actions">
                            <button onclick="changeQuantity(${item.id}, -1)">−</button>
                            <span class="cart-item-quantity">${item.quantity}</span>
                            <button onclick="changeQuantity(${item.id}, 1)">+</button>
                            <button class="remove-item" onclick="removeFromCart(${item.id})"><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        window.changeQuantity = (id, delta) => {
            const index = cart.findIndex(item => item.id === id);
            if (index !== -1) {
                cart[index].quantity += delta;
                if (cart[index].quantity <= 0) {
                    cart.splice(index, 1);
                }
                updateCart();
            }
        };

        window.removeFromCart = (id) => {
            cart = cart.filter(item => item.id !== id);
            updateCart();
            showNotification('Товар удалён');
        };

        // Уведомления
        function showNotification(text, isError = false) {
            notification.textContent = text;
            notification.style.background = isError ? '#e63946' : '#0f172a';
            notification.classList.add('show');
            setTimeout(() => {
                notification.classList.remove('show');
            }, 2000);
        }

        // Открыть/закрыть корзину
        window.toggleCart = () => {
            document.getElementById('cartOverlay').classList.toggle('active');
            document.getElementById('cartSidebar').classList.toggle('active');
        };

        // Фильтрация по категориям
        document.querySelectorAll('.category-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                renderProducts(btn.dataset.category);
            });
        });

        // Инициализация
        renderProducts();
        updateCart();

        // Закрытие корзины по ESC
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                document.getElementById('cartOverlay').classList.remove('active');
                document.getElementById('cartSidebar').classList.remove('active');
            }
        });
    </script>

