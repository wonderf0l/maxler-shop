    <script>
        // Функция открытия формы оформления заказа
        window.openCheckoutForm = function() {
            if (cart.length === 0) {
                showNotification('Корзина пуста', true);
                return;
            }
            
            const orderProductsList = document.getElementById('orderProductsList');
            orderProductsList.innerHTML = cart.map(item => `
                <div class="order-product-item">
                    <span class="order-product-name">${item.name} (${item.taste}) x${item.quantity}</span>
                    <span class="order-product-price">${(item.price * item.quantity).toLocaleString()} ₽</span>
                </div>
            `).join('');
            
            const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            document.getElementById('orderTotalAmount').textContent = total.toLocaleString() + ' ₽';
            
            document.getElementById('checkoutModal').classList.add('show');
        };
        
        window.closeCheckoutModal = function() {
            document.getElementById('checkoutModal').classList.remove('show');
        };
        
        window.submitOrder = function(event) {
    event.preventDefault();
    
    const formData = new FormData();
    formData.append('fullName', document.getElementById('fullName').value);
    formData.append('phone', document.getElementById('phone').value);
    formData.append('city', document.getElementById('city').value);
    formData.append('address', document.getElementById('address').value);
    formData.append('comment', document.getElementById('comment').value);
    formData.append('payment', document.querySelector('input[name="payment"]:checked').value);
    
    // Добавляем товары одной строкой
    const productsList = cart.map(item => 
        `${item.name} (${item.taste}) x${item.quantity} — ${item.price}₽ = ${item.price * item.quantity}₽`
    ).join('\n');
    formData.append('products', productsList);
    
    const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    formData.append('total', total + ' ₽');
    formData.append('date', new Date().toLocaleString());
    
    // Отправляем на Formspree
    fetch('https://formspree.io/f/xgolkdly', {  // ⚠️ ЗАМЕНИТЕ НА СВОЙ URL
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
    })
    .then(response => {
        if (response.ok) {
            // Успех
            const successNotif = document.getElementById('successNotification');
            successNotif.classList.add('show');
            
            // Очищаем корзину
            cart = [];
            updateCart();
            closeCheckoutModal();
            
            setTimeout(() => successNotif.classList.remove('show'), 3000);
            
            // Сохраняем в localStorage (как и раньше)
            const orders = JSON.parse(localStorage.getItem('maxlerOrders')) || [];
            orders.push({
                fullName: document.getElementById('fullName').value,
                phone: document.getElementById('phone').value,
                city: document.getElementById('city').value,
                address: document.getElementById('address').value,
                comment: document.getElementById('comment').value,
                payment: document.querySelector('input[name="payment"]:checked').value,
                products: cart.map(item => ({
                    name: item.name,
                    taste: item.taste,
                    quantity: item.quantity,
                    price: item.price,
                    total: item.price * item.quantity
                })),
                total: total,
                date: new Date().toLocaleString()
            });
            localStorage.setItem('maxlerOrders', JSON.stringify(orders));
            
        } else {
            // Ошибка
            alert('Ошибка при отправке заказа. Попробуйте ещё раз.');
        }
    })
    .catch(error => {
        alert('Ошибка соединения. Проверьте интернет.');
    });
};
